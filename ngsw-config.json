{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
  {
    "name": "data",
    "version": 1,
    "cacheConfig": {
           "strategy": "freshness",
           "maxAge": "365d",
           "maxSize": 10000,
           "timeout": "10s"
         },
         "urls": [ "https://slawek-staniec.pl/blogapp/wp-json/wp/v2/**",
         "https://slawek-staniec.pl/blogapp/wp-json/jwt-auth/v1/**",
         "https://slawek-staniec.pl/blogapp/wp-content/uploads/**",
          "/category**",
          "/blogapp**",
          "/posts**",
           "/post/**",
           "/users**"
         ]
      }
  ]
}
